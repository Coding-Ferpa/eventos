# Copie este arquivo para `.env` e preencha os valores. Nunca commite `.env`.
#
# As chaves aqui correspondem exatamente ao schema de `src/lib/env.ts`, e
# `pnpm check:env` falha o CI se divergirem. O contrato completo está no
# doc 01.
#
# Este arquivo cresce junto com os milestones, e cada bloco diz em qual deles
# entrou. Variável que ainda não tem código que a leia não entra: declará-la
# antes da hora esvaziaria o gate, que existe justamente para recusar build
# com variável obrigatória faltando.

# --- M0 · público (vai para o bundle do navegador: sem segredos) ---

# URL canônica do site. Em desenvolvimento: http://localhost:3000
# Entra no QR de todo certificado (doc 05): errar aqui imprime QR quebrado.
NEXT_PUBLIC_SITE_URL=

# --- M1 · servidor (segredos: só na Vercel, nunca no repositório) ---

# Pooler Supavisor em modo transaction, usado pelo Drizzle. Local (depois de
# `pnpm db:start`): postgresql://postgres:postgres@127.0.0.1:54422/postgres
DATABASE_URL=

# --- M2 · público: Supabase Auth ---

# Local: http://127.0.0.1:54421 (as portas deste projeto são as padrão + 100)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima, impressa por `pnpm db:status`. É pública: quem protege os
# dados é a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- M2 · servidor: GitHub OAuth (opcional) ---
# Sem estas duas o botão "Entrar com GitHub" não aparece e a entrada é só por
# e-mail e senha. Preencha ao criar o OAuth App do GitHub; a URL de callback é
# {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- M3 · servidor: cookie de dispositivo e hash diário (doc 08) ---
# VALORES DE DESENVOLVIMENTO: servem para rodar local e no CI. Eles estão no
# repositório, então são públicos, e o schema os recusa dentro da Vercel. Em
# produção, gere cada um com `openssl rand -base64 32`.

# HMAC do cookie `cf-dispositivo`, emitido pelo proxy na primeira visita.
DEVICE_COOKIE_SECRET=desenvolvimento-local-cookie-de-dispositivo-cf-eventos
# HMAC diário de IP e de dispositivo: gira à meia-noite UTC.
IP_HASH_SECRET=desenvolvimento-local-hash-diario-de-ip-e-dispositivo

# --- M4 · servidor: Storage ---

# Chave de serviço do Supabase: emite a URL assinada do upload da capa e lê o
# que foi enviado. Ignora a RLS, então só vive no servidor. Local: o
# SERVICE_ROLE_KEY impresso por `pnpm db:status`.
SUPABASE_SERVICE_ROLE_KEY=

# --- M7 · servidor: HMAC do CPF (ADR-0005) ---
# VALOR DE DESENVOLVIMENTO, como os do M3, e recusado dentro da Vercel.
# Em produção: `openssl rand -base64 32`, guardado por dois admins. NUNCA
# rotacionar e NUNCA perder: o CPF original não existe para recalcular o hash
# (doc 08). A chave do HMAC é este texto como está.
CPF_PEPPER=desenvolvimento-local-pepper-do-cpf-cf-eventos-nao-usar

# --- M8 · servidor: cookie de retirada (ADR-0010) ---
# AES-256-GCM: 32 bytes em base64. VALOR DE DESENVOLVIMENTO (o texto
# decodificado começa com "desenvolvimento-local-"), recusado dentro da
# Vercel. Em produção: `openssl rand -base64 32`. Trocar só derruba as
# retiradas abertas, que duram 30 minutos.
RETRIEVAL_COOKIE_KEY=ZGVzZW52b2x2aW1lbnRvLWxvY2FsLXJldGlyYWRhMzI=

# --- Ainda não chegaram, e o milestone de cada grupo (doc 01) ---
#
# M8   RESEND_API_KEY, EMAIL_FROM, ADMIN_NOTIFICATION_EMAIL
# M9   DIRECT_URL (quando o deploy de migrations a ler), NEXT_PUBLIC_SENTRY_DSN,
#      SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
# M11  CRON_SECRET, RESEND_WEBHOOK_SECRET, EMAIL_DAILY_LIMIT,
#      EMAIL_MONTHLY_LIMIT
# M12  LINKEDIN_ORGANIZATION_ID
#
# Os outros dois segredos criptográficos (RETRIEVAL_COOKIE_KEY e CRON_SECRET)
# virão como os do M3 e o do M7: com valor de desenvolvimento preenchido,
# marcado como tal, para o seed local funcionar sem cerimônia. Em produção
# cada um é gerado com `openssl rand -base64 32`.
