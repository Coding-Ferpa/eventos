# Copie este arquivo para `.env` e preencha os valores. Nunca commite `.env`.
#
# As chaves aqui correspondem exatamente ao schema de `src/lib/env.ts`, e
# `pnpm check:env` falha o CI se divergirem. O contrato completo está no
# doc 01.
#
# Este arquivo cresce junto com os milestones, e cada bloco diz em qual deles
# entrou. Variável que ainda não tem código que a leia não entra: declará-la
# antes da hora esvaziaria o gate, que existe justamente para recusar build
# com variável obrigatória faltando.

# --- M0 · público (vai para o bundle do navegador: sem segredos) ---

# URL canônica do site. Em desenvolvimento: http://localhost:3000
# Entra no QR de todo certificado (doc 05): errar aqui imprime QR quebrado.
NEXT_PUBLIC_SITE_URL=

# --- M1 · servidor (segredos: só na Vercel, nunca no repositório) ---

# Pooler Supavisor em modo transaction, usado pelo Drizzle. Local (depois de
# `pnpm db:start`): postgresql://postgres:postgres@127.0.0.1:54422/postgres
DATABASE_URL=

# --- M2 · público: Supabase Auth ---

# Local: http://127.0.0.1:54421 (as portas deste projeto são as padrão + 100)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima, impressa por `pnpm db:status`. É pública: quem protege os
# dados é a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- M2 · servidor: GitHub OAuth (opcional) ---
# Sem estas duas o botão "Entrar com GitHub" não aparece e a entrada é só por
# e-mail e senha. Preencha ao criar o OAuth App do GitHub; a URL de callback é
# {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- Ainda não chegaram, e o milestone de cada grupo (doc 01) ---
#
# M3   DEVICE_COOKIE_SECRET (o cookie de dispositivo nasce na primeira visita)
# M4   SUPABASE_SERVICE_ROLE_KEY (URL assinada de upload no Storage)
# M8   CPF_PEPPER, RETRIEVAL_COOKIE_KEY, IP_HASH_SECRET, RESEND_API_KEY,
#      EMAIL_FROM, ADMIN_NOTIFICATION_EMAIL
# M9   DIRECT_URL (quando o deploy de migrations a ler), NEXT_PUBLIC_SENTRY_DSN,
#      SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
# M11  CRON_SECRET, RESEND_WEBHOOK_SECRET, EMAIL_DAILY_LIMIT,
#      EMAIL_MONTHLY_LIMIT
# M12  LINKEDIN_ORGANIZATION_ID
#
# Os cinco segredos criptográficos (CPF_PEPPER, RETRIEVAL_COOKIE_KEY,
# DEVICE_COOKIE_SECRET, IP_HASH_SECRET e CRON_SECRET) virão com valor de
# desenvolvimento preenchido, marcado como tal, para o seed local funcionar
# sem cerimônia. Em produção cada um é gerado com `openssl rand -base64 32`.
# O CPF_PEPPER nunca é rotacionado nem pode ser perdido (doc 08).
