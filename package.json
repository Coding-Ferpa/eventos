{
  "name": "cf-eventos",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma open source de certificados de eventos da comunidade Coding Ferpa",
  "license": "MIT",
  "engines": {
    "node": ">=26.13 <27"
  },
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:gate:pdf": "vitest run pdf-accents",
    "test:gate:csv": "vitest run csv-encoding",
    "fixtures:anonymize": "tsx scripts/anonymize-csv.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "check:env": "tsx scripts/check-env.ts",
    "db:start": "supabase start && tsx scripts/migrar.ts --seeds-locais",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset && tsx scripts/migrar.ts --seeds-locais",
    "db:migrar": "tsx scripts/migrar.ts",
    "db:test": "supabase test db",
    "check:schema": "tsx --env-file-if-exists=.env scripts/check-schema.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:fonts": "tsx scripts/check-fonts.ts",
    "check:fonts-trace": "tsx scripts/check-fonts-trace.ts",
    "check:public-bundle": "tsx scripts/check-public-bundle.ts"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@hookform/resolvers": "^7.0.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.5.438",
    "postgres": "3.4.9",
    "qrcode-generator": "2.0.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "^0.16.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "jsqr": "1.4.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.7",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
